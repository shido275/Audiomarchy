#!/bin/bash
#
# audiomarchy — studio control for an Omarchy workstation.
#
# This is the single command behind every Music menu entry: audio engine
# profiles, devices, session mode, plugin bridging and the doctor. It reads
# and writes only user config, so it survives `omarchy update`.
#
set -uo pipefail

VERSION="0.1.0"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/audiomarchy"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/audiomarchy"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/audiomarchy"
PROFILE_FILE="$CONFIG_DIR/profile"
PIPEWIRE_DROPIN="${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/pipewire.conf.d/90-audiomarchy.conf"
LOOPBACK_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/pipewire-pulse.conf.d/90-audiomarchy-loopback.conf"
PROJECTS_DIR="${AUDIOMARCHY_MUSIC_DIR:-$HOME/Music/Audiomarchy}/Projects"
SESSION_DIR="$STATE_DIR/session"

if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; GREEN=$'\033[32m'
  YELLOW=$'\033[33m'; RED=$'\033[31m'; PURPLE=$'\033[35m'; RESET=$'\033[0m'
else
  BOLD=""; DIM=""; GREEN=""; YELLOW=""; RED=""; PURPLE=""; RESET=""
fi

say() { printf '%s==>%s %s\n' "$PURPLE" "$RESET" "$*"; }
ok() { printf '%s  ok%s %s\n' "$GREEN" "$RESET" "$*"; }
note() { printf '%s    %s%s\n' "$DIM" "$*" "$RESET"; }
warn() { printf '%s warn%s %s\n' "$YELLOW" "$RESET" "$*" >&2; }
fail() { printf '%sfail%s %s\n' "$RED" "$RESET" "$*" >&2; }
hdr() { printf '\n%s%s%s\n' "$BOLD" "$*" "$RESET"; }

notify() {
  command -v notify-send >/dev/null 2>&1 &&
    notify-send -a Audiomarchy -i audio-card "$1" "${2:-}" >/dev/null 2>&1
  return 0
}

usage() {
  cat <<'USAGE'
audiomarchy — studio control for Omarchy

Usage: audiomarchy <group> <command>

  audio status              engine state, sample rate, quantum, buffer time
  audio latency [PROFILE]   safe | balanced | low | ultra (no arg: show)
  audio reset               return to the saved default buffer
  audio restart             restart PipeWire, WirePlumber and pulse

  device list               sinks and sources
  device loopback on|off    virtual cable, BlackHole-style
  device usb-power on|off   stop USB interfaces from autosuspending

  session start [NAME]      recording focus mode (DND, performance, no idle)
  session stop
  session status
  session start --offline   also switch Wi-Fi off for the session

  plugins scan              bridge and rescan Windows VST2/VST3 plugins
  plugins status            yabridge status
  plugins dirs              create the standard plugin/project folders

  project new "Name"        scaffold a project folder
  project list
  project open

  doctor                    check the whole audio path
  menu                      rebuild the Music menu
  refresh                   rebuild menu and studio window rules
  update                    pull this repo and rerun the installer
  version
USAGE
}

# --- audio engine ---------------------------------------------------------

meta() {
  pw-metadata -n settings 0 "$1" 2>/dev/null |
    sed -n "s/.*value:'\([^']*\)'.*/\1/p" | head -1
}

quantum_for() {
  case "$1" in
    safe) echo 1024 ;;
    balanced) echo 256 ;;
    low) echo 128 ;;
    ultra) echo 64 ;;
    *) return 1 ;;
  esac
}

profile_current() {
  head -1 "$PROFILE_FILE" 2>/dev/null | grep -E '^(safe|balanced|low|ultra)$' || echo unset
}

pipewire_running() {
  pw-cli info 0 >/dev/null 2>&1
}

buffer_ms() {
  awk -v q="$1" -v r="$2" 'BEGIN { if (r > 0) printf "%.2f", q / r * 1000; else printf "?" }'
}

write_pipewire_dropin() {
  local quantum=$1
  mkdir -p "$(dirname "$PIPEWIRE_DROPIN")"
  cat > "$PIPEWIRE_DROPIN" <<EOF
# Audiomarchy — generated by \`audiomarchy audio latency\`.
# Change the profile through the CLI rather than editing this file; it is
# rewritten on every profile switch.
context.properties = {
    default.clock.rate          = 48000
    default.clock.allowed-rates = [ 44100 48000 88200 96000 ]
    default.clock.quantum       = $quantum
    default.clock.min-quantum   = 32
    default.clock.max-quantum   = 2048
}
EOF
}

audio_status() {
  local profile quantum forced rate active_q sink sources
  profile=$(profile_current)
  quantum=$(meta clock.quantum)
  forced=$(meta clock.force-quantum)
  rate=$(meta clock.rate)
  quantum=${quantum:-0}
  forced=${forced:-0}
  rate=${rate:-0}
  active_q=$quantum
  (( forced > 0 )) && active_q=$forced

  say "Audiomarchy audio engine"
  printf '  profile   %s\n' "$profile"
  printf '  rate      %s Hz\n' "${rate:-unknown}"
  if (( forced > 0 )); then
    printf '  quantum   %s (forced)\n' "$forced"
  else
    printf '  quantum   %s\n' "${quantum:-unknown}"
  fi
  printf '  buffer    %s ms per period\n' "$(buffer_ms "$active_q" "$rate")"

  sink=$(pactl get-default-sink 2>/dev/null)
  printf '  output    %s\n' "${sink:-none}"

  if command -v pactl >/dev/null 2>&1; then
    hdr "Sinks"
    pactl list short sinks 2>/dev/null | awk '{ printf "  %-52s %s\n", $2, $5 }'
    sources=$(pactl list short sources 2>/dev/null | grep -v '\.monitor' | wc -l)
    note "$sources input source(s)"
  else
    wpctl status 2>/dev/null | sed -n '/Audio/,/Video/p'
  fi
}

audio_latency() {
  local name=${1:-} quantum
  if [[ -z $name ]]; then
    hdr "Latency profiles"
    printf '  %-10s %-8s %s\n' "profile" "quantum" "buffer at 48 kHz"
    local p
    for p in safe balanced low ultra; do
      printf '  %-10s %-8s %s ms\n' "$p" "$(quantum_for "$p")" \
        "$(buffer_ms "$(quantum_for "$p")" 48000)"
    done
    printf '\n  current: %s\n' "$(profile_current)"
    return 0
  fi

  quantum=$(quantum_for "$name") || {
    fail "unknown profile: $name (safe, balanced, low, ultra)"
    return 2
  }

  write_pipewire_dropin "$quantum"
  mkdir -p "$CONFIG_DIR"
  printf '%s\n' "$name" > "$PROFILE_FILE"

  if pipewire_running; then
    pw-metadata -n settings 0 clock.force-quantum "$quantum" >/dev/null 2>&1
    ok "quantum $quantum applied live — $(buffer_ms "$quantum" "$(meta clock.rate)") ms per period"
  else
    warn "PipeWire is not running; the profile applies on the next start"
  fi
  ok "profile '$name' saved"

  notify "Latency: $name" "quantum $quantum — $(buffer_ms "$quantum" 48000) ms"
}

audio_reset() {
  write_pipewire_dropin "$(quantum_for balanced)"
  mkdir -p "$CONFIG_DIR"
  printf 'balanced\n' > "$PROFILE_FILE"
  if pipewire_running; then
    pw-metadata -n settings 0 clock.force-quantum 0 >/dev/null 2>&1
    ok "runtime buffer override cleared"
  fi
  ok "back to the balanced profile"
}

audio_restart() {
  say "Restarting the audio server"
  if command -v omarchy-restart-pipewire >/dev/null 2>&1; then
    omarchy-restart-pipewire
  else
    systemctl --user restart wireplumber.service pipewire.service 2>/dev/null
    systemctl --user --quiet is-active pipewire-pulse.service &&
      systemctl --user restart pipewire-pulse.service
  fi
  ok "audio restarted"
}

audio_cmd() {
  case "${1:-status}" in
    status) audio_status ;;
    latency) shift; audio_latency "${1:-}" ;;
    reset) audio_reset ;;
    restart) audio_restart ;;
    *) fail "unknown audio command: ${1:-}"; usage; return 2 ;;
  esac
}

# --- devices --------------------------------------------------------------

device_list() {
  if ! command -v pactl >/dev/null 2>&1; then
    wpctl status
    return
  fi
  hdr "Outputs"
  pactl list short sinks 2>/dev/null | awk '{ printf "  %-52s %s\n", $2, $5 }'
  hdr "Inputs"
  pactl list short sources 2>/dev/null | grep -v '\.monitor' |
    awk '{ printf "  %-52s %s\n", $2, $5 }'
  if [[ -f $LOOPBACK_CONF ]]; then
    hdr "Virtual"
    note "Audiomarchy Loopback is on (sink + mic pair)"
  fi
}

loopback_enable() {
  local src="$DATA_DIR/repo/config/pipewire-pulse/90-audiomarchy-loopback.conf"
  mkdir -p "$(dirname "$LOOPBACK_CONF")"
  if [[ -f $LOOPBACK_CONF ]]; then
    note "loopback is already on"
  elif [[ -f $LOOPBACK_CONF.disabled ]]; then
    mv "$LOOPBACK_CONF.disabled" "$LOOPBACK_CONF"
    ok "loopback enabled"
  elif [[ -f $src ]]; then
    cp "$src" "$LOOPBACK_CONF"
    ok "loopback enabled"
  else
    fail "loopback config not found — reinstall Audiomarchy"
    return 1
  fi
  systemctl --user restart pipewire-pulse.service 2>/dev/null &&
    ok "pipewire-pulse restarted" ||
    warn "pipewire-pulse is not running; the loopback appears on the next start"
}

loopback_disable() {
  if [[ -f $LOOPBACK_CONF ]]; then
    mv "$LOOPBACK_CONF" "$LOOPBACK_CONF.disabled"
    ok "loopback disabled"
    systemctl --user restart pipewire-pulse.service 2>/dev/null ||
      warn "pipewire-pulse is not running"
  else
    note "loopback is already off"
  fi
}

loopback_status() {
  if [[ -f $LOOPBACK_CONF ]]; then
    ok "loopback is on"
    note "sink: audiomarchy_loopback   mic: audiomarchy_loopback"
  else
    note "loopback is off"
  fi
}

# USB audio-class interfaces drop off when the kernel autosuspends them,
# which shows up as a device that disappears mid-session. Walk sysfs and
# pin the parent USB device's power control.
usb_audio_controls() {
  local dev intf class
  for dev in /sys/bus/usb/devices/*/; do
    for intf in "$dev"*:1.*/; do
      [[ -r $intf/bInterfaceClass ]] || continue
      class=$(cat "$intf/bInterfaceClass" 2>/dev/null)
      [[ $class == 01* ]] || continue
      [[ -w "$dev/power/control" ]] && printf '%s\n' "$dev/power/control"
    done
  done | sort -u
}

device_usb_power() {
  local mode=${1:-} controls count=0 value
  case "$mode" in
    on) ;;
    off) ;;
    *) fail "usage: audiomarchy device usb-power on|off"; return 2 ;;
  esac

  mapfile -t controls < <(usb_audio_controls)
  if (( ${#controls[@]} == 0 )); then
    note "no USB audio interfaces detected"
    return 0
  fi

  local value=on
  [[ $mode == off ]] && value=auto
  sudo bash -c 'v=$1; shift; for c in "$@"; do echo "$v" > "$c"; done' _ "$value" "${controls[@]}" ||
    { fail "could not write USB power control (needs sudo)"; return 1; }
  count=${#controls[@]}
  ok "USB audio power control set to '$value' on $count device interface(s)"
}

device_cmd() {
  case "${1:-list}" in
    list) device_list ;;
    loopback)
      shift
      case "${1:-status}" in
        on) loopback_enable ;;
        off) loopback_disable ;;
        status) loopback_status ;;
        *) fail "usage: audiomarchy device loopback on|off|status"; return 2 ;;
      esac
      ;;
    usb-power) shift; device_usb_power "${1:-}" ;;
    *) fail "unknown device command: ${1:-}"; usage; return 2 ;;
  esac
}

# --- session mode ---------------------------------------------------------

session_active() {
  [[ -f $SESSION_DIR/active ]]
}

session_start() {
  local name="Session" offline=0 inhibit_pid prev_force
  while (( $# )); do
    case "$1" in
      --offline) offline=1 ;;
      *) name="$1" ;;
    esac
    shift
  done

  if session_active; then
    warn "a session is already running — stop it first"
    return 1
  fi

  mkdir -p "$SESSION_DIR"
  printf '%s\n' "$name" > "$SESSION_DIR/active"
  date '+%Y-%m-%d %H:%M' > "$SESSION_DIR/started"

  profile_current > "$SESSION_DIR/profile"
  prev_force=$(meta clock.force-quantum)
  printf '%s\n' "${prev_force:-0}" > "$SESSION_DIR/force-quantum"

  if command -v powerprofilesctl >/dev/null 2>&1; then
    powerprofilesctl get > "$SESSION_DIR/power" 2>/dev/null
    powerprofilesctl set performance >/dev/null 2>&1 &&
      ok "power profile: performance"
  fi

  if command -v makoctl >/dev/null 2>&1; then
    makoctl mode 2>/dev/null | head -1 > "$SESSION_DIR/mako"
    makoctl mode -a do-not-disturb >/dev/null 2>&1 &&
      ok "notifications: do not disturb"
  fi

  if command -v systemd-inhibit >/dev/null 2>&1; then
    systemd-inhibit --what=idle:sleep:handle-lid-switch \
      --who=Audiomarchy --why="Recording session" \
      --mode=block sleep infinity >/dev/null 2>&1 &
    inhibit_pid=$!
    printf '%s\n' "$inhibit_pid" > "$SESSION_DIR/inhibit"
    ok "idle and suspend inhibited"
  fi

  if (( offline )) && command -v nmcli >/dev/null 2>&1; then
    nmcli radio wifi 2>/dev/null | head -1 > "$SESSION_DIR/wifi"
    nmcli radio wifi off >/dev/null 2>&1 && ok "Wi-Fi off for the session"
  fi

  if pipewire_running; then
    pw-metadata -n settings 0 clock.force-quantum 128 >/dev/null 2>&1 &&
      ok "buffer: 128 frames ($(buffer_ms 128 "$(meta clock.rate)") ms)"
  fi

  notify "Session started: $name" "Focus mode is on"
  say "Session '$name' is running"
  note "audiomarchy session stop to put everything back"
}

session_stop() {
  local pid prev_force

  if ! session_active; then
    note "no session is running"
    return 0
  fi

  if [[ -f $SESSION_DIR/inhibit ]]; then
    pid=$(cat "$SESSION_DIR/inhibit")
    if [[ -n $pid ]]; then
      pkill -P "$pid" 2>/dev/null
      kill "$pid" 2>/dev/null
    fi
    ok "idle and suspend released"
  fi

  if [[ -f $SESSION_DIR/power ]]; then
    powerprofilesctl set "$(cat "$SESSION_DIR/power")" >/dev/null 2>&1 &&
      ok "power profile restored"
  fi

  if [[ -f $SESSION_DIR/mako ]]; then
    grep -q 'do-not-disturb' "$SESSION_DIR/mako" ||
      makoctl mode -r do-not-disturb >/dev/null 2>&1
    ok "notifications restored"
  fi

  if [[ -f $SESSION_DIR/wifi ]]; then
    nmcli radio wifi on >/dev/null 2>&1 && ok "Wi-Fi restored"
  fi

  prev_force=$(cat "$SESSION_DIR/force-quantum" 2>/dev/null || echo 0)
  if pipewire_running; then
    pw-metadata -n settings 0 clock.force-quantum "${prev_force:-0}" >/dev/null 2>&1
    ok "buffer restored"
  fi

  rm -rf "$SESSION_DIR"
  notify "Session finished" "Everything is back to normal"
  say "Session stopped"
}

session_status() {
  if ! session_active; then
    note "no session is running"
    return 0
  fi
  hdr "Session: $(head -1 "$SESSION_DIR/active")"
  [[ -f $SESSION_DIR/started ]] && echo "  started  $(cat "$SESSION_DIR/started")"
  echo "  quantum  $(meta clock.force-quantum) (forced)"
  echo "  profile  $(cat "$SESSION_DIR/profile" 2>/dev/null || echo unknown) before the session"
}

session_cmd() {
  case "${1:-status}" in
    start) shift; session_start "$@" ;;
    stop) session_stop ;;
    status) session_status ;;
    *) fail "unknown session command: ${1:-}"; usage; return 2 ;;
  esac
}

# --- plugins and projects -------------------------------------------------

plugins_dirs() {
  local dir
  for dir in "$HOME/.vst" "$HOME/.vst3" "$HOME/.lv2" "$HOME/.clap" \
    "$PROJECTS_DIR" "${PROJECTS_DIR%/Projects}/Renders" \
    "${PROJECTS_DIR%/Projects}/Samples" "${PROJECTS_DIR%/Projects}/Recordings" \
    "${PROJECTS_DIR%/Projects}/Presets"; do
    mkdir -p "$dir"
    note "$dir"
  done
}

plugins_scan() {
  plugins_dirs
  if command -v yabridgectl >/dev/null 2>&1; then
    say "Bridging Windows plugins"
    yabridgectl sync
    echo
    yabridgectl status
  else
    warn "yabridgectl is not installed — install yabridge with ./install.sh"
  fi
  echo
  note "VST2 ~/.vst    VST3 ~/.vst3    LV2 ~/.lv2    CLAP ~/.clap"
  note "Point your DAW's plugin scan at those folders."
}

plugins_cmd() {
  case "${1:-scan}" in
    scan|sync) plugins_scan ;;
    status)
      command -v yabridgectl >/dev/null 2>&1 &&
        yabridgectl status || warn "yabridgectl is not installed"
      ;;
    dirs) plugins_dirs ;;
    *) fail "unknown plugins command: ${1:-}"; usage; return 2 ;;
  esac
}

project_new() {
  local name="$*" dir
  [[ -n $name ]] || { fail "usage: audiomarchy project new \"Name\""; return 2; }
  dir="$PROJECTS_DIR/$name"
  if [[ -e $dir ]]; then
    fail "already exists: $dir"
    return 1
  fi
  mkdir -p "$dir/Stems" "$dir/Renders" "$dir/Recordings"
  cat > "$dir/session.md" <<EOF
# $name

Started: $(date '+%Y-%m-%d')

## Intent


## Arrangement


## Mix notes


## Session log

- $(date '+%Y-%m-%d'): project created
EOF
  ok "created $dir"
  note "Stems/  Renders/  Recordings/  session.md"
}

project_cmd() {
  case "${1:-list}" in
    new) shift; project_new "$@" ;;
    list)
      if [[ -d $PROJECTS_DIR ]]; then
        find "$PROJECTS_DIR" -mindepth 1 -maxdepth 1 -type d -printf '  %f\n' 2>/dev/null |
          sort
      else
        note "no projects yet — audiomarchy project new \"Name\""
      fi
      ;;
    open) mkdir -p "$PROJECTS_DIR"; xdg-open "$PROJECTS_DIR" >/dev/null 2>&1 & ;;
    *) fail "unknown project command: ${1:-}"; usage; return 2 ;;
  esac
}

# --- doctor ---------------------------------------------------------------

doctor() {
  local fails=0 warns=0 rate quantum forced active_q rtp mem sink active_q_ms
  local -a autosuspend=()
  local sample kernel governor

  hdr "Audio engine"
  if pipewire_running; then
    ok "PipeWire is running"
  else
    fail "PipeWire is not running"
    fails=$((fails + 1))
  fi

  if pacman -Qq pipewire-jack >/dev/null 2>&1; then
    ok "pipewire-jack is installed"
  else
    warn "pipewire-jack is missing — JACK-only apps cannot connect"
    warns=$((warns + 1))
  fi

  rate=$(meta clock.rate)
  quantum=$(meta clock.quantum)
  forced=$(meta clock.force-quantum)
  rate=${rate:-0}
  quantum=${quantum:-0}
  forced=${forced:-0}
  active_q=$quantum
  (( forced > 0 )) && active_q=$forced

  if (( active_q > 0 && active_q <= 512 )); then
    ok "buffer quantum $active_q ($(buffer_ms "$active_q" "$rate") ms at $rate Hz)"
  elif (( active_q > 512 )); then
    warn "buffer quantum $active_q is large — audiomarchy audio latency low tightens it"
    warns=$((warns + 1))
  else
    warn "could not read the buffer quantum"
    warns=$((warns + 1))
  fi

  hdr "Realtime scheduling"
  rtp=$(ulimit -r)
  mem=$(ulimit -l)
  if [[ $rtp == "unlimited" ]] || (( rtp >= 95 )); then
    ok "rtprio limit $rtp"
  else
    fail "rtprio limit $rtp (needs 95) — log out and back in after the installer's group change"
    fails=$((fails + 1))
  fi
  if [[ $mem == "unlimited" ]]; then
    ok "memlock unlimited"
  else
    warn "memlock limit $mem — expect xruns under load"
    warns=$((warns + 1))
  fi
  if id -nG "$USER" 2>/dev/null | grep -qw realtime; then
    ok "user is in the realtime group"
  else
    fail "user is not in the realtime group — run the installer, then log out and back in"
    fails=$((fails + 1))
  fi

  hdr "Devices"
  sink=$(pactl get-default-sink 2>/dev/null)
  if [[ -n $sink ]]; then
    ok "default output: $sink"
  else
    warn "no default output device"
    warns=$((warns + 1))
  fi

  mapfile -t autosuspend < <(usb_audio_controls)
  if (( ${#autosuspend[@]} > 0 )); then
    local ctl state auto=0
    for ctl in "${autosuspend[@]}"; do
      state=$(cat "$ctl" 2>/dev/null)
      [[ $state == auto ]] && auto=$((auto + 1))
    done
    if (( auto > 0 )); then
      warn "$auto USB audio interface(s) can autosuspend — audiomarchy device usb-power on"
      warns=$((warns + 1))
    else
      ok "USB audio interfaces are pinned on"
    fi
  fi

  hdr "Stability"
  if command -v pw-top >/dev/null 2>&1; then
    sample=$(timeout 5 pw-top -b -n 1 2>/dev/null |
      awk '$1 ~ /^[A-Z]$/ && $9 ~ /^[0-9]+$/ { sum += $9 } END { print sum + 0 }')
    if [[ ${sample:-0} == 0 ]]; then
      ok "no xruns reported by the current graph"
    else
      warn "$sample xrun(s) reported — tighten the buffer only after fixing load"
      warns=$((warns + 1))
    fi
  fi

  kernel=$(uname -r)
  if [[ $kernel == *rt* ]]; then
    ok "realtime kernel: $kernel"
  else
    note "kernel: $kernel (the stock kernel is fine for most interfaces)"
  fi

  if [[ -r /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]]; then
    governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)
    note "CPU governor: $governor"
  fi

  if command -v rtcqs >/dev/null 2>&1; then
    note "deeper checks: rtcqs"
  fi

  hdr "Summary"
  if (( fails > 0 )); then
    fail "$fails problem(s), $warns warning(s) — fix the failures first"
    return 1
  fi
  if (( warns > 0 )); then
    warn "no failures, $warns warning(s)"
    return 0
  fi
  ok "everything checks out"
}

# --- integration ----------------------------------------------------------

menu_rebuild() {
  local script="$DATA_DIR/repo/install/music/menu.sh"
  [[ -f $script ]] || { fail "menu builder not found — reinstall Audiomarchy"; return 1; }
  AUDIOMARCHY_INSTALL="$DATA_DIR/repo/install" bash "$script"
}

hypr_refresh() {
  local src="$DATA_DIR/repo/config/hypr/audiomarchy.conf"
  local dest="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/audiomarchy.conf"
  [[ -f $src ]] || { warn "studio window rules not found"; return 1; }
  mkdir -p "$(dirname "$dest")"
  cp -f "$src" "$dest"
  ok "studio window rules refreshed"
  command -v hyprctl >/dev/null 2>&1 && hyprctl reload >/dev/null 2>&1
}

self_update() {
  local repo="$DATA_DIR/repo" packs
  [[ -d $repo/.git ]] || {
    fail "no git checkout in $repo — reinstall from a clone to enable updates"
    return 1
  }
  say "Pulling the latest Audiomarchy"
  git -C "$repo" pull --ff-only || { fail "pull failed — resolve it in $repo"; return 1; }
  packs=$(paste -sd, "$STATE_DIR/installed-packs" 2>/dev/null)
  say "Rerunning the installer"
  # shellcheck disable=SC2086
  bash "$repo/install.sh" --pack "${packs:-core}"
}

case "${1:-help}" in
  audio) shift; audio_cmd "$@" ;;
  device) shift; device_cmd "$@" ;;
  session) shift; session_cmd "$@" ;;
  plugins|plugin) shift; plugins_cmd "$@" ;;
  project|projects) shift; project_cmd "$@" ;;
  doctor) doctor ;;
  menu) menu_rebuild ;;
  refresh) menu_rebuild; hypr_refresh ;;
  update) self_update ;;
  version|-v|--version) echo "audiomarchy $VERSION" ;;
  help|-h|--help) usage ;;
  *) fail "unknown command: ${1:-}"; echo >&2; usage; exit 2 ;;
esac
